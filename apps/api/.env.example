# Copie para apps/api/.env. Nunca versione o arquivo .env.
DATABASE_URL=postgres://forge:forge_local_only@db:5432/forge
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# Troque pelos dois e-mails reais autorizados ANTES de cadastrar as contas.
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:3000
APP_TIME_ZONE=America/Sao_Paulo
DB_POOL_MAX=10
PORT=8787
UPLOAD_MAX_MB=8
PRIVATE_UPLOAD_DIR=.private-uploads
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
