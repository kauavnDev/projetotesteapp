{
  "name": "forge-seu-amanha",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:api": "pnpm --filter @forge/api dev",
    "dev:mobile": "pnpm --filter @forge/mobile start",
    "dev:web": "pnpm --filter @forge/web dev",
    "db:generate": "pnpm --filter @forge/api db:generate",
    "db:migrate": "pnpm --filter @forge/api db:migrate",
    "db:seed": "pnpm --filter @forge/api db:seed",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": { "turbo": "^2.0.0" }
}