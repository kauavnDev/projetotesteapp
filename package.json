{
  "name": "forge-o-seu-amanha",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @forge/api db:generate",
    "db:migrate": "pnpm --filter @forge/api db:migrate",
    "db:studio": "pnpm --filter @forge/api db:studio",
    "verify:static": "node scripts/verify-static.mjs",
    "test:static": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
